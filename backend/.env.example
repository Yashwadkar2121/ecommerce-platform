NODE_ENV=development
PORT=5000

# Frontend URL(s) allowed to call this API (CORS). Separate several with commas.
FRONTEND_URL=http://localhost:5173

# ---------- SQL database (users, orders, payments) ----------
# Cloud (production): TiDB Cloud Starter - MySQL compatible, free tier.
# TiDB Cloud > your cluster > Connect shows these values. Port is 4000 and
# the user looks like "abc123.root".
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_user.root
DB_PASSWORD=your_tidb_password
DB_NAME=ecommerce
DB_SSL=true
# Only set to false for a server with a self-signed certificate
# DB_SSL_REJECT_UNAUTHORIZED=true

# Local MySQL (development fallback when DB_HOST is empty or unreachable)
LOCAL_DB_NAME=ecommerce_db
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306

# Tables are created automatically in development. In production run
# `npm run db:sync` once instead (or set DB_SYNC=true).
# DB_SYNC=false

# ---------- MongoDB (products, reviews) ----------
MONGODB_URI_ATLAS=mongodb+srv://<username>:<db_password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/ecommerce_db

# ---------- Redis (cart + product cache) ----------
# Upstash gives a rediss://... URL. Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# ---------- Payments ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen` (local) or the webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
# Tax rate applied to orders (0.1 = 10%)
TAX_RATE=0.1

# ---------- Product images (Cloudinary, free plan) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_FOLDER=ecommerce/products

# ---------- AI features (Google Gemini, free tier) ----------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Models are configurable because Google retires old ones:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Protects the free quota (per visitor per minute / per day, and for the whole app per day)
# AI_LIMIT_PER_MINUTE=10
# AI_LIMIT_PER_DAY=80
# AI_GLOBAL_LIMIT_PER_DAY=800

# ---------- Email (password reset OTP) ----------
# Gmail: use an App Password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=My Store
