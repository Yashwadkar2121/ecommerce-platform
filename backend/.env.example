NODE_ENV=development
PORT=5000
# Used for CORS and PayPal redirect URLs
FRONTEND_URL=http://localhost:5173
# Tax rate applied to orders (0.1 = 10%)
TAX_RATE=0.1

# Aiven MySQL
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_HOST=mysql-12345-yourproject.aivencloud.com
DB_PORT=12345

# Local MySQL
LOCAL_DB_NAME=ecommerce_db
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306


# MongoDB
MONGODB_URI_ATLAS=mongodb+srv://<username>:<db_password>@cluster0.g3vvj.mongodb.net/?appName=Cluster0
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/ecommerce_db

# JWT
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# From `stripe listen` (local) or the Stripe dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Redis
REDIS_URL=redis://localhost:6379
